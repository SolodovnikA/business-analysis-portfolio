    <bpmn:startEvent id="S1" name="Нужна субсидия на ЖКУ">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T1" name="1. Подать заявление на субсидию">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G1" name="Способ подачи?">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T2a" name="2. Проверить комплектность документов">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T2b" name="2. Зарегистрировать заявление в журнале учёта">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T2c" name="2. Отправить заявление в соцзащиту Почтой России">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T3a" name="3. Распечатать заявление для бумажного дела">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T3b" name="3. Передать заявление в соцзащиту через СЭДО">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G2" name="">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T4" name="4. Зарегистрировать заявление в журнале учёта ИС">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T5" name="5. Повторно ввести данные заявления в ИС">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="P1" name="">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="T6" name="6. Отправить электронный запрос в расчётный центр ЖКХ">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T7" name="7. Отправить бумажный запрос в расчётный центр почтой">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="P2" name="">
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="T8" name="8. Перевести заявление в статус ожидания ответа">
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateThrowEvent id="E_rc" name="Ответ из расчётного центра получен">
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:outgoing>F19</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    <bpmn:task id="T9" name="9. Проверить сумму задолженности">
      <bpmn:incoming>F19</bpmn:incoming>
      <bpmn:outgoing>F20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G3" name="Задолженность больше порога?">
      <bpmn:incoming>F20</bpmn:incoming>
      <bpmn:outgoing>F21</bpmn:outgoing>
      <bpmn:outgoing>F24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T10" name="10. Направить заявителю уведомление о погашении долга">
      <bpmn:incoming>F21</bpmn:incoming>
      <bpmn:outgoing>F22</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T11" name="11. Закрыть заявление">
      <bpmn:incoming>F22</bpmn:incoming>
      <bpmn:outgoing>F23</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End1" name="Заявление закрыто">
      <bpmn:incoming>F23</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T12" name="12. Направить запрос в налоговую о доходах семьи">
      <bpmn:incoming>F24</bpmn:incoming>
      <bpmn:outgoing>F25</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateThrowEvent id="E_fns" name="Ответ из налоговой получен">
      <bpmn:incoming>F25</bpmn:incoming>
      <bpmn:outgoing>F26</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    <bpmn:task id="T13" name="13. Рассчитать размер субсидии">
      <bpmn:incoming>F26</bpmn:incoming>
      <bpmn:outgoing>F27</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T15" name="15. Проверить расчёт и вернуть на повторную проверку">
      <bpmn:incoming>F27</bpmn:incoming>
      <bpmn:outgoing>F28</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T16a" name="16. Повторно проверить данные">
      <bpmn:incoming>F28</bpmn:incoming>
      <bpmn:outgoing>F29</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T16b" name="16. Утвердить расчёт">
      <bpmn:incoming>F29</bpmn:incoming>
      <bpmn:outgoing>F30</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T17" name="17. Направить решение в финансовый отдел">
      <bpmn:incoming>F30</bpmn:incoming>
      <bpmn:outgoing>F31</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T18" name="18. Сформировать выплату">
      <bpmn:incoming>F31</bpmn:incoming>
      <bpmn:outgoing>F32</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="P3" name="">
      <bpmn:incoming>F32</bpmn:incoming>
      <bpmn:outgoing>F33</bpmn:outgoing>
      <bpmn:outgoing>F34</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="T18b" name="18. Отправить уведомление через портал госуслуг">
      <bpmn:incoming>F33</bpmn:incoming>
      <bpmn:outgoing>F35</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T18c" name="18. Отправить уведомление почтовым письмом">
      <bpmn:incoming>F34</bpmn:incoming>
      <bpmn:outgoing>F36</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="P4" name="">
      <bpmn:incoming>F35</bpmn:incoming>
      <bpmn:incoming>F36</bpmn:incoming>
      <bpmn:outgoing>F37</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="End2" name="Выплата сформирована">
      <bpmn:incoming>F37</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="S1" targetRef="T1" />
    <bpmn:sequenceFlow id="F2" sourceRef="T1" targetRef="G1" />
    <bpmn:sequenceFlow id="F3" name="лично в МФЦ" sourceRef="G1" targetRef="T2a" />
    <bpmn:sequenceFlow id="F4" name="через портал" sourceRef="G1" targetRef="T3a" />
    <bpmn:sequenceFlow id="F5" sourceRef="T2a" targetRef="T2b" />
    <bpmn:sequenceFlow id="F6" sourceRef="T2b" targetRef="T2c" />
    <bpmn:sequenceFlow id="F7" sourceRef="T2c" targetRef="G2" />
    <bpmn:sequenceFlow id="F8" sourceRef="T3a" targetRef="T3b" />
    <bpmn:sequenceFlow id="F9" sourceRef="T3b" targetRef="G2" />
    <bpmn:sequenceFlow id="F10" sourceRef="G2" targetRef="T4" />
    <bpmn:sequenceFlow id="F11" sourceRef="T4" targetRef="T5" />
