    <bpmn:sequenceFlow id="F20" sourceRef="T9" targetRef="G3" />
    <bpmn:sequenceFlow id="F21" name="да" sourceRef="G3" targetRef="T10" />
    <bpmn:sequenceFlow id="F22" sourceRef="T10" targetRef="T11" />
    <bpmn:sequenceFlow id="F23" sourceRef="T11" targetRef="End1" />
    <bpmn:sequenceFlow id="F24" name="нет" sourceRef="G3" targetRef="T12" />
    <bpmn:sequenceFlow id="F25" sourceRef="T12" targetRef="E_fns" />
    <bpmn:sequenceFlow id="F26" sourceRef="E_fns" targetRef="T13" />
    <bpmn:sequenceFlow id="F27" name="14. расчёт" sourceRef="T13" targetRef="T15" />
    <bpmn:sequenceFlow id="F28" name="на проверку" sourceRef="T15" targetRef="T16a" />
    <bpmn:sequenceFlow id="F29" sourceRef="T16a" targetRef="T16b" />
    <bpmn:sequenceFlow id="F30" sourceRef="T16b" targetRef="T17" />
    <bpmn:sequenceFlow id="F31" sourceRef="T17" targetRef="T18" />
    <bpmn:sequenceFlow id="F32" sourceRef="T18" targetRef="P3" />
    <bpmn:sequenceFlow id="F33" sourceRef="P3" targetRef="T18b" />
    <bpmn:sequenceFlow id="F34" sourceRef="P3" targetRef="T18c" />
    <bpmn:sequenceFlow id="F35" sourceRef="T18b" targetRef="P4" />
    <bpmn:sequenceFlow id="F36" sourceRef="T18c" targetRef="P4" />
    <bpmn:sequenceFlow id="F37" sourceRef="P4" targetRef="End2" />
    <bpmn:textAnnotation id="A1"><bpmn:text>Оранжевым — шаги, которые нужно оптимизировать. Красным — ошибки в логике процесса</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="A2"><bpmn:text>Электронное заявление зачем-то распечатывают — лишняя работа, можно сразу передавать в электронном виде</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="As_A2" associationDirection="None" sourceRef="A2" targetRef="T3a" />
    <bpmn:textAnnotation id="A3"><bpmn:text>Нет ветки, что делать если документов не хватает</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="As_A3" associationDirection="None" sourceRef="A3" targetRef="T2a" />
    <bpmn:textAnnotation id="A4"><bpmn:text>Почта России — это несколько дней, хотя есть СЭДО</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="As_A4" associationDirection="None" sourceRef="A4" targetRef="T2c" />
    <bpmn:textAnnotation id="A5"><bpmn:text>Шаг 7 дублирует электронный запрос (шаг 6). И в описании ошибка: «одновременно с шагом 7» — должно быть с шагом 6</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="As_A5" associationDirection="None" sourceRef="A5" targetRef="T7" />
    <bpmn:textAnnotation id="A6"><bpmn:text>Одни и те же данные вводятся второй раз</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="As_A6" associationDirection="None" sourceRef="A6" targetRef="T5" />
    <bpmn:textAnnotation id="A7"><bpmn:text>Ждём ответа без срока, нет контроля если ответ не придёт</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="As_A7" associationDirection="None" sourceRef="A7" targetRef="T8" />
    <bpmn:textAnnotation id="A8"><bpmn:text>Запросов два, значит ответов тоже два — непонятно какой обрабатывать</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="As_A8" associationDirection="None" sourceRef="A8" targetRef="E_rc" />
    <bpmn:textAnnotation id="A9"><bpmn:text>Запрос в налоговую можно отправить вместе с запросом в РЦ, а не после него</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="As_A9" associationDirection="None" sourceRef="A9" targetRef="T12" />
    <bpmn:textAnnotation id="A10"><bpmn:text>Нет ветки, если субсидия по доходу не положена</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="As_A10" associationDirection="None" sourceRef="A10" targetRef="T13" />
    <bpmn:textAnnotation id="A11"><bpmn:text>Заявление просто закрывается, а решения об отказе нет</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="As_A11" associationDirection="None" sourceRef="A11" targetRef="T11" />
    <bpmn:textAnnotation id="A12"><bpmn:text>Руководитель всегда возвращает расчёт на перепроверку, без причины — лишний круг</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="As_A12" associationDirection="None" sourceRef="A12" targetRef="T15" />
    <bpmn:textAnnotation id="A13"><bpmn:text>Не указано, кто направляет решение. И заявителю о решении никто не сообщает</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="As_A13" associationDirection="None" sourceRef="A13" targetRef="T17" />
    <bpmn:textAnnotation id="A14"><bpmn:text>Одно и то же уведомление отправляется два раза</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="As_A14" associationDirection="None" sourceRef="A14" targetRef="T18c" />
  </bpmn:process>
