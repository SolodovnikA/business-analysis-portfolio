<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="17.11.1">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="P_App" name="Заявитель" />
    <bpmn:participant id="P_MFC" name="МФЦ" processRef="Proc_MFC" />
    <bpmn:participant id="P_GIS" name="ГИС ЖКХ" />
    <bpmn:participant id="P_OSZN" name="Орган соцзащиты: назначение субсидии на оплату ЖКУ (TO BE)" processRef="Proc_OSZN" />
    <bpmn:participant id="P_FNS" name="ФНС России" />
    <bpmn:messageFlow id="Msg_1" name="заявление и документы" sourceRef="P_App" targetRef="M_S" />
    <bpmn:messageFlow id="Msg_2" name="заявление через ЕПГУ" sourceRef="P_App" targetRef="S_EPGU" />
    <bpmn:messageFlow id="Msg_3" name="заявление (СЭДО)" sourceRef="M_E1" targetRef="S_MFC" />
    <bpmn:messageFlow id="Msg_4" name="запрос" sourceRef="T4a" targetRef="P_GIS" />
    <bpmn:messageFlow id="Msg_5" name="сведения о задолженности" sourceRef="P_GIS" targetRef="T5" />
    <bpmn:messageFlow id="Msg_6" name="запрос" sourceRef="T4b" targetRef="P_FNS" />
    <bpmn:messageFlow id="Msg_7" name="сведения о доходах" sourceRef="P_FNS" targetRef="T5" />
    <bpmn:messageFlow id="Msg_8" name="решение" sourceRef="N1" targetRef="P_App" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_MFC" isExecutable="false">
    <bpmn:startEvent id="M_S" name="Заявитель обратился в МФЦ">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_M_S" />
    </bpmn:startEvent>
    <bpmn:userTask id="M_1" name="1. Принять заявление и проверить комплектность (АИС МФЦ)">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="M_G" name="Комплект полный?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="M_2" name="2. Отсканировать документы и передать в соцзащиту (СЭДО)">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="M_E1" name="Заявление передано в соцзащиту">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:messageEventDefinition id="MED_M_E1" />
    </bpmn:endEvent>
    <bpmn:manualTask id="M_3" name="2.1 Вернуть документы с перечнем недостающих">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="M_E2" name="В приёме заявления отказано">
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="M_S" targetRef="M_1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="M_1" targetRef="M_G" />
    <bpmn:sequenceFlow id="Flow_3" name="да" sourceRef="M_G" targetRef="M_2" />
    <bpmn:sequenceFlow id="Flow_4" name="нет" sourceRef="M_G" targetRef="M_3" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="M_2" targetRef="M_E1" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="M_3" targetRef="M_E2" />
    <bpmn:textAnnotation id="Ann_2"><bpmn:text>Было: распечатка ЕПГУ-заявлений и отправка Почтой России</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="As_Ann_2" associationDirection="None" sourceRef="Ann_2" targetRef="M_2" />
  </bpmn:process>
  <bpmn:process id="Proc_OSZN" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="L_IS" name="ИС соцзащиты (автоматически)">
        <bpmn:flowNodeRef>S_EPGU</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_MFC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T51</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_rep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>O1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>O2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_ref</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Spec" name="Специалист соцзащиты">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>D1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Head" name="Руководитель отдела соцзащиты">
        <bpmn:flowNodeRef>H1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Fin" name="Финансовый отдел">
        <bpmn:flowNodeRef>F1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>F2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_pay</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S_EPGU" name="Заявление поступило с ЕПГУ">
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_S_EPGU" />
    </bpmn:startEvent>
    <bpmn:startEvent id="S_MFC" name="Заявление поступило из МФЦ">
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_S_MFC" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="G1" name="">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T3" name="3. Автоматически зарегистрировать заявление в ИС (однократный ввод)">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="P1" name="">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sendTask id="T4a" name="4. Запросить сведения о задолженности в ГИС ЖКХ (СМЭВ)">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="T4b" name="4. Запросить сведения о доходах семьи в ФНС (СМЭВ)">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:parallelGateway id="P2" name="">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:receiveTask id="T5" name="5. Получить ответы на межведомственные запросы">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:boundaryEvent id="BT" name="48 часов без ответа" cancelActivity="false" attachedToRef="T5">
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_BT"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT48H</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="T51" name="5.1 Направить повторный запрос">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E_rep" name="Повторный запрос направлен">
      <bpmn:incoming>Flow_17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="T6" name="6. Проверить основания для отказа, рассчитать субсидию">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G2" name="Право на субсидию есть?">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="S1" name="7. Проверить расчёт, подготовить проект решения о назначении">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="S2" name="7. Подготовить проект решения об отказе с указанием оснований">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G3" name="">
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:incoming>Flow_24</bpmn:incoming>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="H1" name="8. Рассмотреть и подписать решение ЭП">
      <bpmn:incoming>Flow_25</bpmn:incoming>
      <bpmn:outgoing>Flow_26</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G4" name="Есть замечания?">
      <bpmn:incoming>Flow_26</bpmn:incoming>
      <bpmn:outgoing>Flow_27</bpmn:outgoing>
      <bpmn:outgoing>Flow_28</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="D1" name="8.1 Доработать проект решения по замечаниям">
      <bpmn:incoming>Flow_27</bpmn:incoming>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:inclusiveGateway id="O1" name="Каналы уведомления, выбранные заявителем">
      <bpmn:incoming>Flow_28</bpmn:incoming>
      <bpmn:outgoing>Flow_29</bpmn:outgoing>
      <bpmn:outgoing>Flow_30</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:sendTask id="N1" name="9. Направить решение в личный кабинет ЕПГУ">
      <bpmn:incoming>Flow_29</bpmn:incoming>
      <bpmn:outgoing>Flow_31</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:manualTask id="N2" name="9. Направить решение почтовым письмом">
      <bpmn:incoming>Flow_30</bpmn:incoming>
      <bpmn:outgoing>Flow_32</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:inclusiveGateway id="O2" name="">
      <bpmn:incoming>Flow_31</bpmn:incoming>
      <bpmn:incoming>Flow_32</bpmn:incoming>
      <bpmn:outgoing>Flow_33</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:exclusiveGateway id="G5" name="Решение о назначении?">
      <bpmn:incoming>Flow_33</bpmn:incoming>
      <bpmn:outgoing>Flow_34</bpmn:outgoing>
      <bpmn:outgoing>Flow_35</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E_ref" name="В назначении субсидии отказано">
      <bpmn:incoming>Flow_34</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="F1" name="10. Включить получателя в выплатной реестр на 6 месяцев">
      <bpmn:incoming>Flow_35</bpmn:incoming>
      <bpmn:outgoing>Flow_36</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="F2" name="11. Перечислить субсидию за месяц">
      <bpmn:incoming>Flow_36</bpmn:incoming>
      <bpmn:outgoing>Flow_37</bpmn:outgoing>
      <bpmn:standardLoopCharacteristics />
    </bpmn:serviceTask>
    <bpmn:endEvent id="E_pay" name="Субсидия выплачена за весь период">
      <bpmn:incoming>Flow_37</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="S_MFC" targetRef="G1" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="S_EPGU" targetRef="G1" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="G1" targetRef="T3" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="T3" targetRef="P1" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="P1" targetRef="T4a" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="P1" targetRef="T4b" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="T4a" targetRef="P2" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="T4b" targetRef="P2" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="P2" targetRef="T5" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="BT" targetRef="T51" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="T51" targetRef="E_rep" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="T5" targetRef="T6" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="T6" targetRef="G2" />
    <bpmn:sequenceFlow id="Flow_20" name="да" sourceRef="G2" targetRef="S1" />
    <bpmn:sequenceFlow id="Flow_21" name="нет" sourceRef="G2" targetRef="S2" />
    <bpmn:sequenceFlow id="Flow_22" sourceRef="S1" targetRef="G3" />
    <bpmn:sequenceFlow id="Flow_23" sourceRef="S2" targetRef="G3" />
    <bpmn:sequenceFlow id="Flow_24" sourceRef="D1" targetRef="G3" />
    <bpmn:sequenceFlow id="Flow_25" sourceRef="G3" targetRef="H1" />
    <bpmn:sequenceFlow id="Flow_26" sourceRef="H1" targetRef="G4" />
    <bpmn:sequenceFlow id="Flow_27" name="да" sourceRef="G4" targetRef="D1" />
    <bpmn:sequenceFlow id="Flow_28" name="нет" sourceRef="G4" targetRef="O1" />
    <bpmn:sequenceFlow id="Flow_29" name="ЕПГУ" sourceRef="O1" targetRef="N1" />
    <bpmn:sequenceFlow id="Flow_30" name="почта" sourceRef="O1" targetRef="N2" />
    <bpmn:sequenceFlow id="Flow_31" sourceRef="N1" targetRef="O2" />
    <bpmn:sequenceFlow id="Flow_32" sourceRef="N2" targetRef="O2" />
    <bpmn:sequenceFlow id="Flow_33" sourceRef="O2" targetRef="G5" />
    <bpmn:sequenceFlow id="Flow_34" name="нет" sourceRef="G5" targetRef="E_ref" />
    <bpmn:sequenceFlow id="Flow_35" name="да" sourceRef="G5" targetRef="F1" />
    <bpmn:sequenceFlow id="Flow_36" sourceRef="F1" targetRef="F2" />
    <bpmn:sequenceFlow id="Flow_37" sourceRef="F2" targetRef="E_pay" />
    <bpmn:textAnnotation id="Ann_1"><bpmn:text>Зелёным — шаги, изменённые или добавленные при реинжиниринге (TO BE)</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="Ann_3"><bpmn:text>Было: регистрация в журнале + повторный ввод данных</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="As_Ann_3" associationDirection="None" sourceRef="Ann_3" targetRef="T3" />
    <bpmn:textAnnotation id="Ann_4"><bpmn:text>Было: бумажный дубль запроса и запросы по очереди</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="As_Ann_4" associationDirection="None" sourceRef="Ann_4" targetRef="T4b" />
    <bpmn:textAnnotation id="Ann_5"><bpmn:text>Было: ожидание ответа без срока</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="As_Ann_5" associationDirection="None" sourceRef="Ann_5" targetRef="BT" />
    <bpmn:textAnnotation id="Ann_6"><bpmn:text>Было: заявление просто закрывалось без решения</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="As_Ann_6" associationDirection="None" sourceRef="Ann_6" targetRef="S2" />
    <bpmn:textAnnotation id="Ann_7"><bpmn:text>Было: возврат на перепроверку всегда, без причины</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="As_Ann_7" associationDirection="None" sourceRef="Ann_7" targetRef="G4" />
    <bpmn:textAnnotation id="Ann_8"><bpmn:text>Было: уведомление всегда и через портал, и письмом</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="As_Ann_8" associationDirection="None" sourceRef="Ann_8" targetRef="O1" />
    <bpmn:textAnnotation id="Ann_9"><bpmn:text>Было: одна разовая выплата</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="As_Ann_9" associationDirection="None" sourceRef="Ann_9" targetRef="F2" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1"><bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
    <bpmndi:BPMNShape id="P_App_di" bpmnElement="P_App" isHorizontal="true"><dc:Bounds x="0" y="40" width="3480" height="90" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="P_MFC_di" bpmnElement="P_MFC" isHorizontal="true"><dc:Bounds x="0" y="170" width="830" height="245" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="P_GIS_di" bpmnElement="P_GIS" isHorizontal="true"><dc:Bounds x="1220" y="230" width="480" height="90" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="P_OSZN_di" bpmnElement="P_OSZN" isHorizontal="true"><dc:Bounds x="0" y="430" width="3480" height="930" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="P_FNS_di" bpmnElement="P_FNS" isHorizontal="true"><dc:Bounds x="1220" y="1400" width="480" height="90" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="L_IS_di" bpmnElement="L_IS" isHorizontal="true"><dc:Bounds x="30" y="430" width="3450" height="310" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="L_Spec_di" bpmnElement="L_Spec" isHorizontal="true"><dc:Bounds x="30" y="740" width="3450" height="220" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="L_Head_di" bpmnElement="L_Head" isHorizontal="true"><dc:Bounds x="30" y="960" width="3450" height="200" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="L_Fin_di" bpmnElement="L_Fin" isHorizontal="true"><dc:Bounds x="30" y="1160" width="3450" height="200" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="M_S_di" bpmnElement="M_S"><dc:Bounds x="92" y="252" width="36" height="36" /></bpmndi:BPMNShape>
